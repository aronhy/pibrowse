 namespace {

+// Draw the profile number on the engine's original icon without modifying
+// any resources in the signed application bundle.
+void DrawPibrowseDockNumber(NSString* serial) {
+  const CGFloat font_size = std::min<CGFloat>(105, 325.0 / serial.length);
+  NSDictionary* attributes = @{
+    NSFontAttributeName :
+        [NSFont monospacedDigitSystemFontOfSize:font_size
+                                        weight:NSFontWeightBold],
+    NSForegroundColorAttributeName : NSColor.whiteColor
+  };
+  const NSSize text = [serial sizeWithAttributes:attributes];
+  const CGFloat height = 136;
+  const CGFloat width = std::max(height, text.width + 38);
+  const NSRect badge = NSMakeRect(474 - width, 38, width, height);
+  NSBezierPath* outline = [NSBezierPath bezierPathWithRoundedRect:badge
+                                                        xRadius:height / 2
+                                                        yRadius:height / 2];
+  [[NSColor colorWithSRGBRed:0.09 green:0.11 blue:0.15 alpha:1.0] setFill];
+  [outline fill];
+  [NSColor.whiteColor setStroke];
+  outline.lineWidth = 6;
+  [outline stroke];
+  [serial drawAtPoint:NSMakePoint(NSMidX(badge) - text.width / 2,
+                                 NSMidY(badge) - text.height / 2)
+       withAttributes:attributes];
+}
+
+void SetPibrowseDockIcon() {
+  int64_t number = 0;
+  if (!base::StringToInt64(
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              "pibrowse-dock-number"),
+          &number) ||
+      number <= 0) {
+    return;
+  }
+
+  NSImage* base_icon = NSApp.applicationIconImage;
+  if (!base_icon) {
+    return;
+  }
+  NSString* serial =
+      [NSString stringWithFormat:@"%02lld", static_cast<long long>(number)];
+  NSImage* icon =
+      [NSImage imageWithSize:NSMakeSize(512, 512)
+                     flipped:NO
+              drawingHandler:^BOOL(NSRect frame) {
+                [base_icon drawInRect:frame
+                            fromRect:NSZeroRect
+                           operation:NSCompositingOperationSourceOver
+                            fraction:1.0];
+                DrawPibrowseDockNumber(serial);
+                return YES;
+              }];
+  NSApp.applicationIconImage = icon;
+}
