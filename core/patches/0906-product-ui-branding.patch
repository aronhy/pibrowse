+<translation id="6579604491060606493">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ PiBrowse ಅನ್ನು ಬಳಸಬಹುದು. ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಸಹ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
 <translation id="1709772298389099340"><ph name="BROWSER_NAME" /> ಗಾಗಿ ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಅನ್ನು ಒದಗಿಸುತ್ತದೆ.</translation>
 <translation id="1722488837206509557">ಲಭ್ಯವಿರುವ ಸಾಧನಗಳಿಂದ ಆಯ್ಕೆ ಮಾಡಲು ಮತ್ತು ಅವುಗಳಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಪ್ರದರ್ಶಿಸಲು ಇದು ನಿಮಗೆ ಅನುಮತಿಸುತ್ತದೆ.</translation>
-<translation id="1733725117201708356">Chromium ಶೀಘ್ರದಲ್ಲೇ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
-<translation id="1736443181683099871">ನ್ಯಾವಿಗೇಶನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಲು Chromium ಪ್ರಯತ್ನಿಸುತ್ತದೆ</translation>
-<translation id="1736662517232558588">Chromium ಡೇಟಾ ತೆರವುಗೊಳಿಸಲಾಗಿದೆ</translation>
-<translation id="1745121272106313518"><ph name="REMAINING_TIME" /> ಸೆಕೆಂಡ್‌ಗಳಲ್ಲಿ Chromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ</translation>
-<translation id="1749104137266986751">HTTPS ಲಭ್ಯವಿಲ್ಲದಿದ್ದಾಗ, Chromium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡದೆ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತದೆ</translation>
-<translation id="1774152462503052664">Chromium ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಗೊಳ್ಳಲು ಅನುಮತಿಸಿ</translation>
-<translation id="1779356040007214683">Chromium  ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ನಲ್ಲಿ ನಾವು ಪಟ್ಟಿ ಮಾಡಲಾದ ಕೆಲವು ವಿಸ್ತರಣೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಿರಬಹುದು.</translation>
